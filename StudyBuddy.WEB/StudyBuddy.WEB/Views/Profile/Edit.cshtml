@model StudyBuddy.WEB.Models.User.UserUpdateViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<section class="sb-profile-edit-page">
    <div class="container">
        <div class="sb-profile-edit-shell">
            <aside class="sb-profile-edit-intro">
                <span>Profile builder</span>
                <h1>Make your StudyBuddy profile easier to trust.</h1>
                <p>
                    A clear university, major, and short intro helps other students decide faster.
                </p>
            </aside>

            <form asp-action="Edit" method="post" class="sb-profile-edit-form">
                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="sb-profile-field">
                    <label asp-for="NameSurname"></label>
                    <input asp-for="NameSurname" />
                    <span asp-validation-for="NameSurname" class="text-danger"></span>
                </div>

                <div class="sb-profile-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="sb-profile-two-col">
                    <div class="sb-profile-field">
                        <label asp-for="University"></label>
                        <input asp-for="University" />
                    </div>

                    <div class="sb-profile-field">
                        <label asp-for="Major"></label>
                        <input asp-for="Major" />
                    </div>
                </div>

                <div class="sb-profile-field">
                    <label asp-for="AboutMe"></label>
                    <textarea asp-for="AboutMe" rows="5"></textarea>
                </div>

                <div class="sb-profile-edit-actions">
                    <button type="submit" class="btn sb-profile-save">Save Changes</button>
                    <a asp-controller="Profile" asp-action="Index" class="btn sb-profile-cancel">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

<style>
    .sb-profile-edit-page {
        min-height: calc(100vh - 180px);
        padding: 42px 0 86px;
        background: #f7f8fb;
    }

    .sb-profile-edit-page .container {
        max-width: 1120px;
    }

    .sb-profile-edit-shell {
        display: grid;
        grid-template-columns: minmax(300px, 0.78fr) minmax(0, 1.22fr);
        gap: 18px;
        padding: 24px;
        border-radius: 8px;
        background: #111827;
        box-shadow: 0 26px 80px rgba(17, 24, 39, 0.18);
    }

    .sb-profile-edit-intro {
        padding: 30px;
        border-radius: 8px;
        background: linear-gradient(135deg, rgba(255, 79, 134, 0.24), rgba(37, 99, 235, 0.10));
        color: #ffffff;
    }

    .sb-profile-edit-intro span {
        color: #7dd3fc;
        font-size: 13px;
        font-weight: 900;
    }

    .sb-profile-edit-intro h1 {
        font-size: 44px;
        font-weight: 900;
        line-height: 1.04;
        margin: 12px 0 16px;
    }

    .sb-profile-edit-intro p {
        color: #d7deea;
        font-size: 18px;
        line-height: 1.55;
    }

    .sb-profile-edit-form {
        padding: 28px;
        border-radius: 8px;
        background: #ffffff;
    }

    .sb-profile-two-col {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .sb-profile-field {
        margin-bottom: 16px;
    }

    .sb-profile-field label {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: 900;
        margin-bottom: 7px;
    }

    .sb-profile-field input,
    .sb-profile-field textarea {
        width: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #f8fafc;
        color: #111827;
        padding: 13px 14px;
        outline: none;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
    }

    .sb-profile-field input:focus,
    .sb-profile-field textarea:focus {
        border-color: #ff4f86;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(255, 79, 134, 0.12);
    }

    .sb-profile-edit-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 8px;
    }

    .sb-profile-save,
    .sb-profile-cancel {
        min-height: 48px;
        border-radius: 8px;
        padding: 12px 22px;
        font-weight: 900;
    }

    .sb-profile-save {
        background: #ff4f86;
        color: #ffffff !important;
        box-shadow: 0 16px 34px rgba(255, 79, 134, 0.24);
    }

    .sb-profile-cancel {
        border: 1px solid #e5e7eb;
        color: #111827 !important;
        background: #ffffff;
    }

    @@media (max-width: 900px) {
        .sb-profile-edit-shell,
        .sb-profile-two-col {
            grid-template-columns: 1fr;
        }

        .sb-profile-edit-intro h1 {
            font-size: 34px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}