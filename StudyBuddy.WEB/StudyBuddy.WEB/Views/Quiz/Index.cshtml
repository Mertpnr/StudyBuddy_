@model StudyBuddy.WEB.Models.Quiz.QuizPageViewModel

@{
    ViewData["Title"] = "Quiz";
}

<section class="sb-page-header">
    <div class="container">
        <h1 class="fw-bold mb-2">Quiz</h1>
        <p class="text-muted mb-0">Answer the questions so StudyBuddy can find better study partners for you.</p>
    </div>
</section>

<section class="sb-section">
    <div class="container">
        <div class="sb-auth-card">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (Model.Questions == null || !Model.Questions.Any())
            {
                <p class="text-muted">No quiz questions found.</p>
                <a asp-controller="Dashboard" asp-action="Index" class="btn sb-btn-outline">Back to Dashboard</a>
            }
            else
            {
                <form asp-controller="Quiz" asp-action="Submit" method="post">
                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var question = Model.Questions[i];

                        <div class="mb-4 p-3 border rounded">
                            <h5 class="fw-bold mb-3">
                                @(i + 1). @question.Question
                            </h5>

                            @if (question.Options == null || !question.Options.Any())
                            {
                                <p class="text-danger">No options found for this question.</p>
                            }
                            else
                            {
                                foreach (var option in question.Options)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="SelectedOptions[@question.QuestionId]"
                                               value="@option.OptionId"
                                               id="option_@option.OptionId"
                                               required />

                                        <label class="form-check-label" for="option_@option.OptionId">
                                            @option.Text
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    }

                    <button type="submit" class="btn sb-btn-primary">
                        Save Answers
                    </button>

                    <a asp-controller="Dashboard" asp-action="Index" class="btn sb-btn-outline ms-2">
                        Back to Dashboard
                    </a>
                </form>
            }
        </div>
    </div>
</section>
