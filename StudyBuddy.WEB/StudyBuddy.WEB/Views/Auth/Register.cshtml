@model StudyBuddy.WEB.Models.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="sb-auth-section">
    <div class="container">
        <div class="row align-items-center justify-content-center gy-5">
            <div class="col-lg-5 d-none d-lg-block text-center">
                <img src="~/template-assets/mockup-2.png" alt="Register StudyBuddy" class="img-fluid" />
            </div>

            <div class="col-lg-7">
                <div class="sb-auth-card">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">Create your StudyBuddy account</h2>
                        <p class="text-muted mb-0">
                            Register to complete your profile and start matching.
                        </p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NameSurname" class="form-label"></label>
                            <input asp-for="NameSurname" class="form-control sb-form-control" />
                            <span asp-validation-for="NameSurname" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control sb-form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control sb-form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control sb-form-control" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="University" class="form-label"></label>
                            <input asp-for="University" class="form-control sb-form-control" placeholder="Example: KTU" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Major" class="form-label"></label>
                            <input asp-for="Major" class="form-control sb-form-control" placeholder="Example: Software Engineering" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="AboutMe" class="form-label"></label>
                            <textarea asp-for="AboutMe" class="form-control sb-form-control" rows="3"></textarea>
                        </div>

                        <button type="submit" class="btn sb-btn-primary w-100">
                            Register
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        Already have an account?
                        <a asp-controller="Auth" asp-action="Login">Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
