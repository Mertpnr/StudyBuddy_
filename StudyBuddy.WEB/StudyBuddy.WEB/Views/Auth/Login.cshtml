@model StudyBuddy.WEB.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<section class="sb-auth-section">
    <div class="container">
        <div class="row align-items-center justify-content-center gy-5">
            <div class="col-lg-5 d-none d-lg-block text-center">
                <img src="~/template-assets/mockup-3.png" alt="Login StudyBuddy" class="img-fluid" />
            </div>

            <div class="col-lg-5">
                <div class="sb-auth-card">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">Welcome back</h2>
                        <p class="text-muted mb-0">
                            Login and continue finding your study matches.
                        </p>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control sb-form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control sb-form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn sb-btn-primary w-100">
                            Login
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        Don't have an account?
                        <a asp-controller="Auth" asp-action="Register">Register</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
