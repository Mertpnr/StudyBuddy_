@model List<StudyBuddy.WEB.Models.Chat.ChatConversationViewModel>

@{
    ViewData["Title"] = "Chats";
}

<section class="sb-chat-list-page">
    <div class="container">
        <div class="sb-chat-list-hero">
            <div>
                <span>Study conversations</span>
                <h1>Your chats</h1>
                <p>Continue conversations with accepted study buddies.</p>
            </div>

            <a asp-controller="Dashboard" asp-action="Index" class="btn sb-chat-back">
                Back to Dashboard
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="sb-chat-empty">
                <h2>No active chats yet</h2>
                <p>Accept a match request first, then your conversations will appear here.</p>

                <a asp-controller="Match" asp-action="Index" class="btn sb-chat-primary">
                    Find Matches
                </a>
            </div>
        }
        else
        {
            <div class="sb-chat-list">
                @foreach (var chat in Model)
                {
                    <a asp-controller="Chat"
                       asp-action="Room"
                       asp-route-matchRequestId="@chat.MatchRequestId"
                       class="sb-chat-item">
                        <div class="sb-chat-avatar">
                            @chat.OtherUserName.FirstOrDefault().ToString().ToUpperInvariant()
                        </div>

                        <div class="sb-chat-content">
                            <div class="sb-chat-topline">
                                <strong>@chat.OtherUserName</strong>

                                @if (chat.LastMessageDate.HasValue)
                                {
                                    <time>@chat.LastMessageDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                                }
                            </div>

                            <div class="sb-chat-meta">
                                @if (!string.IsNullOrWhiteSpace(chat.OtherUserUniversity))
                                {
                                    <span>@chat.OtherUserUniversity</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(chat.OtherUserMajor))
                                {
                                    <span>@chat.OtherUserMajor</span>
                                }
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(chat.LastMessage)
                                    ? "No messages yet. Start the conversation."
                                    : chat.LastMessage)
                            </p>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>

<style>
    .sb-chat-list-page {
        min-height: calc(100vh - 180px);
        padding: 54px 0 86px;
        background: #f7f8fb;
    }

    .sb-chat-list-page .container {
        max-width: 1060px;
    }

    .sb-chat-list-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        padding: 30px;
        margin-bottom: 22px;
        border-radius: 8px;
        background: #111827;
        color: #ffffff;
        box-shadow: 0 24px 70px rgba(17, 24, 39, 0.16);
    }

    .sb-chat-list-hero span {
        display: block;
        color: #7dd3fc;
        font-size: 13px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .sb-chat-list-hero h1 {
        font-size: 46px;
        font-weight: 900;
        margin: 0 0 8px;
    }

    .sb-chat-list-hero p {
        color: #d7deea;
        margin: 0;
    }

    .sb-chat-back,
    .sb-chat-primary {
        min-height: 46px;
        border-radius: 8px;
        padding: 11px 20px;
        font-weight: 900;
    }

    .sb-chat-back {
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: #ffffff !important;
        background: rgba(255, 255, 255, 0.08);
    }

    .sb-chat-primary {
        background: #ff4f86;
        color: #ffffff !important;
        box-shadow: 0 14px 30px rgba(255, 79, 134, 0.24);
    }

    .sb-chat-list {
        display: grid;
        gap: 14px;
    }

    .sb-chat-item {
        display: grid;
        grid-template-columns: 58px minmax(0, 1fr);
        gap: 16px;
        align-items: center;
        padding: 18px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        color: #111827;
        text-decoration: none;
        box-shadow: 0 14px 36px rgba(15, 23, 42, 0.07);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

    .sb-chat-item:hover {
        color: #111827;
        border-color: rgba(37, 99, 235, 0.42);
        box-shadow: 0 22px 54px rgba(15, 23, 42, 0.12);
        transform: translateY(-3px);
    }

    .sb-chat-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 58px;
        border-radius: 8px;
        background: #2563eb;
        color: #ffffff;
        font-size: 20px;
        font-weight: 900;
    }

    .sb-chat-content {
        min-width: 0;
    }

    .sb-chat-topline {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
        margin-bottom: 4px;
    }

    .sb-chat-topline strong {
        font-size: 18px;
        font-weight: 900;
    }

    .sb-chat-topline time,
    .sb-chat-meta,
    .sb-chat-content p {
        color: #64748b;
    }

    .sb-chat-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .sb-chat-content p {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0;
    }

    .sb-chat-empty {
        padding: 56px 24px;
        text-align: center;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
    }

    .sb-chat-empty h2 {
        font-size: 30px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .sb-chat-empty p {
        color: #64748b;
        margin-bottom: 22px;
    }

    @@media (max-width: 768px) {
        .sb-chat-list-hero {
            display: grid;
            align-items: start;
            padding: 22px;
        }

        .sb-chat-list-hero h1 {
            font-size: 36px;
        }

        .sb-chat-topline {
            display: grid;
            gap: 2px;
        }
    }
</style>