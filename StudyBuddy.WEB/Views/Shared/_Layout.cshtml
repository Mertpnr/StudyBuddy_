<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyBuddy</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template-assets/reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template-assets/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template-assets/frontend.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template-assets/frontend.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template-assets/header-footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template-assets/header-footer-elementor.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template-assets/post-70.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template-assets/mukta.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <nav class="navbar navbar-expand-lg sb-navbar">
        <div class="container">
            <a class="navbar-brand sb-brand" asp-controller="Home" asp-action="Index">
                StudyBuddy
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav" aria-controls="navbarNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn sb-btn-outline btn-sm" asp-controller="Auth" asp-action="Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn sb-btn-primary btn-sm" asp-controller="Auth" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="sb-footer">
        <div class="container text-center">
            <p class="mb-0">&copy; @DateTime.Now.Year StudyBuddy. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
