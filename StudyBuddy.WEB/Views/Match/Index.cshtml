@model StudyBuddy.WEB.Models.Match.MatchPageViewModel

@{
    ViewData["Title"] = "Matches";
}

<section class="sb-page-header">
    <div class="container">
        <h1 class="fw-bold mb-2">Find Match</h1>
        <p class="text-muted mb-0">Choose another user and calculate your study compatibility.</p>
    </div>
</section>

<section class="sb-section">
    <div class="container">
        <div class="sb-auth-card">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (Model.Users == null || !Model.Users.Any())
            {
                <p class="text-muted">No other users found.</p>
            }
            else
            {
                <form asp-controller="Match" asp-action="Calculate" method="post">
                    <div class="mb-3">
                        <label class="form-label">Select User</label>
                        <select asp-for="SelectedUserId" class="form-control" required>
                            <option value="">Select a user</option>

                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.UserId">
                                    @user.NameSurname - @user.University - @user.Major
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn sb-btn-primary">
                        Calculate Match
                    </button>

                    <a asp-controller="Dashboard" asp-action="Index" class="btn sb-btn-outline ms-2">
                        Back to Dashboard
                    </a>
                </form>
            }

            @if (Model.Candidates != null && Model.Candidates.Any())
            {
                <hr />

                <h5 class="fw-bold mb-3">Suggested Matches</h5>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>University</th>
                                <th>Major</th>
                                <th>Match</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var candidate in Model.Candidates)
                            {
                                <tr>
                                    <td>@candidate.NameSurname</td>
                                    <td>@candidate.University</td>
                                    <td>@candidate.Major</td>
                                    <td>
                                        @if (candidate.MatchPercent.HasValue)
                                        {
                                            <strong>@((candidate.MatchPercent.Value * 100).ToString("0"))%</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No data</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (candidate.MatchPercent.HasValue && candidate.MatchPercent.Value > 0)
                                        {
                                            <form asp-controller="MatchRequest" asp-action="Create" method="post" class="d-inline">
                                                <input type="hidden" name="receiverUserId" value="@candidate.UserId" />
                                                <input type="hidden" name="message" value="Hi, I want to study together." />

                                                <button type="submit" class="btn sb-btn-primary btn-sm">
                                                    Send Request
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.Result != null)
            {
                <hr />

                <div class="alert alert-info">
                    <h5 class="fw-bold">Match Result</h5>

                    <p>
                        <strong>Match Percent:</strong>
                        @(Model.Result.MatchPercent * 100)%
                    </p>

                    <p>
                        <strong>Shared Question Count:</strong>
                        @Model.Result.SharedQuestionCount
                    </p>

                    <p>
                        <strong>Subject Matched:</strong>
                        @(Model.Result.SubjectMatched ? "Yes" : "No")
                    </p>

                    <p>
                        <strong>Message:</strong>
                        @Model.Result.Message
                    </p>

                    @if (Model.Result.SavedToDatabase)
                    {
                        <form asp-controller="MatchRequest" asp-action="Create" method="post">
                            <input type="hidden" name="receiverUserId" value="@Model.Result.User2Id" />
                            <input type="hidden" name="message" value="Hi, I want to study together." />

                            <button type="submit" class="btn sb-btn-primary">
                                Send Match Request
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</section>
