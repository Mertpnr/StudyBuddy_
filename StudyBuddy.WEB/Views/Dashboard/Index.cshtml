@{
    ViewData["Title"] = "Dashboard";
}

<section class="sb-page-header">
    <div class="container">
        <h1 class="fw-bold mb-2">Dashboard</h1>
        <p class="text-muted mb-0">Welcome, @ViewBag.UserName. Continue your StudyBuddy journey.</p>
    </div>
</section>

<section class="sb-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="sb-dashboard-card">
                    <h5>Profile</h5>
                    <p class="text-muted">
                        View or edit your profile information.
                    </p>
                    <a asp-controller="Profile" asp-action="Index" class="btn sb-btn-outline">
                        Go to Profile
                    </a>
                </div>
            </div>

            <div class="col-md-3">
                <div class="sb-dashboard-card">
                    <h5>Quiz</h5>
                    <p class="text-muted">
                        Answer questions for better matching.
                    </p>
                    <a asp-controller="Quiz" asp-action="Index" class="btn sb-btn-outline">
                        Start Quiz
                    </a>
                </div>
            </div>

            <div class="col-md-3">
                <div class="sb-dashboard-card">
                    <h5>Matches</h5>
                    <p class="text-muted">
                        View compatible study partners.
                    </p>
                    <a asp-controller="Match" asp-action="Index" class="btn sb-btn-outline">
                        View Matches
                    </a>
                </div>
            </div>

            <div class="col-md-3">
                <div class="sb-dashboard-card">
                    <h5>Requests</h5>
                    <p class="text-muted">
                        Manage incoming and outgoing requests.
                    </p>
                    <a asp-controller="MatchRequest" asp-action="Index" class="btn sb-btn-outline">
                        View Requests
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
